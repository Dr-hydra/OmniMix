<Window x:Class="FloatingPlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OmniMixFrontend"
        Title="OmniMix 播放悬浮窗"
        Width="430" Height="190"
        MinWidth="390" MinHeight="176"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Border x:Name="PanRoot" CornerRadius="8" Background="#F020242A" BorderBrush="#40FFFFFF" BorderThickness="1" Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" />
        </Border.Effect>
        <Grid x:Name="PanLayout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="116" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>

            <Border x:Name="PanCover"
                    Width="92"
                    Height="92"
                    CornerRadius="6"
                    Background="#28FFFFFF"
                    ClipToBounds="True"
                    VerticalAlignment="Top">
                <Grid>
                    <Image x:Name="ImgCover"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="Collapsed" />
                    <Path x:Name="PathCoverPlaceholder"
                          Data="M348.293565 716.53287V254.797913c0-41.672348 28.004174-78.358261 68.919652-90.37913L815.994435 40.826435c62.775652-18.610087 125.907478 26.579478 125.907478 89.933913v539.158261c8.013913 42.25113-8.94887 89.177043-47.014956 127.109565a232.848696 232.848696 0 0 1-170.785392 65.758609c-61.885217-2.938435-111.081739-33.435826-129.113043-80.050087-18.031304-46.614261-2.137043-102.177391 41.672348-145.853218a232.848696 232.848696 0 0 1 170.785391-65.80313c21.014261 1.024 40.514783 5.164522 57.878261 12.065391V233.338435c0-12.109913-10.551652-20.034783-20.569044-20.034783a24.620522 24.620522 0 0 0-5.787826 0.934957L439.785739 338.18713a19.545043 19.545043 0 0 0-14.825739 19.144348v438.984348H423.846957c11.53113 43.987478-5.164522 94.208-45.412174 134.322087a232.848696 232.848696 0 0 1-170.785392 65.758609c-61.885217-2.938435-111.081739-33.435826-129.113043-80.050087-18.031304-46.614261-2.137043-102.177391 41.672348-145.853218a232.848696 232.848696 0 0 1 170.785391-65.80313c20.791652 1.024 40.069565 5.075478 57.299478 11.842783z"
                          Stretch="Uniform"
                          Width="32"
                          Height="32"
                          Fill="#B8FFFFFF"
                          Opacity="0.8"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid x:Name="PanInfo" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="LabTitle" Grid.Row="0"
                           Foreground="White" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Text="等待播放实例..." />

                <TextBlock x:Name="LabMeta" Grid.Row="1"
                           Margin="0,4,0,0" Foreground="#B8FFFFFF" FontSize="12"
                           TextTrimming="CharacterEllipsis" Text="正在连接 OmniMix 后端" />

                <TextBlock x:Name="LabLyricCurrent" Grid.Row="2"
                           Margin="0,10,0,0"
                           Foreground="#FFFFFFFF"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="歌词等待中..." />

                <TextBlock x:Name="LabLyricNext" Grid.Row="3"
                           Margin="0,6,0,0"
                           Foreground="#92FFFFFF"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text=" " />
            </Grid>

            <Grid x:Name="PanProgress"
                  Grid.Row="2"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Margin="0,6,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:MySlider x:Name="SliderProgress" Grid.Row="0"
                                Height="16" MaxValue="100" Value="0" />
                <DockPanel Grid.Row="2" LastChildFill="False">
                    <TextBlock x:Name="LabState" DockPanel.Dock="Left"
                               Foreground="#D8FFFFFF" FontSize="11" Text="--" />
                    <TextBlock x:Name="LabTime" DockPanel.Dock="Right"
                               Foreground="#D8FFFFFF" FontSize="11" Text="--" />
                </DockPanel>
            </Grid>

            <StackPanel x:Name="PanCommandButtons"
                        Grid.Row="2"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,6,0,0">
                <local:MyIconButton x:Name="BtnPrev"
                                    Width="34" Height="34" Margin="0,0,12,0"
                                    LogoScale="0.9"
                                    Theme="Color"
                                    ToolTip="上一首" />
                <local:MyIconButton x:Name="BtnToggle"
                                    Width="42" Height="42" Margin="0,0,12,0"
                                    LogoScale="0.85"
                                    Theme="Color"
                                    ToolTip="播放 / 暂停" />
                <local:MyIconButton x:Name="BtnNext"
                                    Width="34" Height="34"
                                    LogoScale="0.9"
                                    Theme="Color"
                                    ToolTip="下一首" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
