<Window x:Class="FloatingPlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniMix 播放悬浮窗"
        Width="320" Height="118"
        MinWidth="260" MinHeight="96"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Border x:Name="PanRoot" CornerRadius="8" Background="#F020242A" BorderBrush="#40FFFFFF" BorderThickness="1" Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LabTitle" Grid.Row="0" Grid.Column="0"
                       Foreground="White" FontSize="15" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Text="等待播放实例..." />
            <Button x:Name="BtnClose" Grid.Row="0" Grid.Column="1"
                    Width="24" Height="24" Margin="8,-4,-6,0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#CCFFFFFF" FontSize="16"
                    Content="×" Cursor="Hand" ToolTip="隐藏悬浮窗" />

            <TextBlock x:Name="LabMeta" Grid.Row="1" Grid.ColumnSpan="2"
                       Margin="0,4,0,0" Foreground="#B8FFFFFF" FontSize="12"
                       TextTrimming="CharacterEllipsis" Text="正在连接 OmniMix 后端" />

            <Grid Grid.Row="3" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar x:Name="BarProgress" Grid.Row="0"
                             Height="5" Minimum="0" Maximum="1" Value="0"
                             Foreground="#FF56C7FF" Background="#28FFFFFF"
                             BorderThickness="0" />
                <DockPanel Grid.Row="2" LastChildFill="False">
                    <TextBlock x:Name="LabState" DockPanel.Dock="Left"
                               Foreground="#D8FFFFFF" FontSize="11" Text="--" />
                    <TextBlock x:Name="LabTime" DockPanel.Dock="Right"
                               Foreground="#D8FFFFFF" FontSize="11" Text="--" />
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
