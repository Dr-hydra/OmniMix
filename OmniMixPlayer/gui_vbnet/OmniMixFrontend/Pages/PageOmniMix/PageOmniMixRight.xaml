<local:MyPageRight x:Class="PageOmniMixRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:OmniMixFrontend"
                   PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="28,24,28,14" Grid.IsSharedSizeScope="True">
            <local:MyCard x:Name="CardHero" Title="OmniMix" Margin="0,0,0,15" Visibility="Collapsed">
                <Grid Margin="20,40,20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="LabTitle"
                                   Text="播放"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush3}" />
                        <TextBlock x:Name="LabSubtitle"
                                   Text="当前播放、队列和音乐源状态。"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Margin="0,8,20,0" />
                        <TextBlock x:Name="LabStatus"
                                   Text=""
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Margin="0,10,20,0" />
                    </StackPanel>
                    <local:MyLoading Grid.Column="1"
                                     x:Name="LoadState"
                                     Height="42"
                                     Width="42"
                                     AutoRun="False"
                                     VerticalAlignment="Center" />
                </Grid>
            </local:MyCard>

            <Grid x:Name="GridHome" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="*" MinWidth="270" />
                </Grid.ColumnDefinitions>

                <local:MyCard x:Name="CardPlayback" Title="当前播放" Grid.Column="0" Margin="0,0,0,15" Visibility="Collapsed">
                    <StackPanel Margin="20,38,20,18">
                        <TextBlock x:Name="LabPlaybackSummary"
                                   Text="等待连接后端..."
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Margin="0,0,0,16" />
                        <Border Height="180"
                                CornerRadius="6"
                                Background="{DynamicResource ColorBrushBackground}"
                                Margin="0,0,0,16">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Margin="26,0">
                                    <TextBlock x:Name="LabPlaybackTrack"
                                               Text="暂无曲目"
                                               TextWrapping="Wrap"
                                               FontSize="25"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ColorBrush3}" />
                                    <TextBlock x:Name="LabPlaybackMeta"
                                               Text=""
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="LabPlaybackInstance"
                                   Text=""
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Margin="0,0,0,12" />
                        <TextBlock x:Name="LabPlaybackPosition"
                                   Text="进度：--"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,18">
                            <local:MyTextButton x:Name="BtnPlaybackPrevLegacy"
                                                Text="上一首"
                                                Padding="12,6,12,6"
                                                Margin="0,0,16,0" />
                            <local:MyTextButton x:Name="BtnPlaybackToggleLegacy"
                                                Text="播放 / 暂停"
                                                Padding="18,7,18,7"
                                                Margin="0,0,16,0" />
                            <local:MyTextButton x:Name="BtnPlaybackNextLegacy"
                                                Text="下一首"
                                                Padding="12,6,12,6" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音量"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource ColorBrush2}"
                                       Margin="0,0,12,0" />
                            <local:MySlider x:Name="SliderVolumeLegacy"
                                            Grid.Column="1"
                                            MaxValue="100"
                                            Value="100"
                                            VerticalAlignment="Center" />
                            <TextBlock x:Name="LabPlaybackVolumeLegacy"
                                       Grid.Column="2"
                                       Text="100%"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource ColorBrushGray3}"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </local:MyCard>

                <local:MyCard x:Name="CardQueue" Title="播放" Grid.Column="2" Margin="0,0,0,15">
                    <StackPanel Margin="20,20,20,18">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Visibility="Collapsed">
                                <TextBlock x:Name="LabHomeTrack"
                                           Text="暂无曲目"
                                           TextWrapping="Wrap"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrush3}" />
                                <TextBlock x:Name="LabHomeMeta"
                                           Text=""
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{DynamicResource ColorBrushGray3}"
                                           Margin="0,7,14,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top">
                                <Border x:Name="PanHomeLyricsTab"
                                        CornerRadius="6"
                                        Background="{DynamicResource ColorBrush7}"
                                        Margin="0,0,6,0">
                                    <local:MyTextButton x:Name="BtnHomeLyricsTab"
                                                        Text="歌词"
                                                        Padding="12,5,12,5" />
                                </Border>
                                <Border x:Name="PanHomePlaylistTab"
                                        CornerRadius="6"
                                        Background="{DynamicResource ColorBrushSemiTransparent}">
                                    <local:MyTextButton x:Name="BtnHomePlaylistTab"
                                                        Text="播放列表"
                                                        Padding="12,5,12,5" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="LabHomeInstance"
                                   Text=""
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Margin="0,0,0,8"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="LabHomePosition"
                                   Text="进度：--"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Margin="0,0,0,12"
                                   Visibility="Collapsed" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="Collapsed">
                            <local:MyTextButton x:Name="BtnPlaybackPrev"
                                                Text="上一首"
                                                Padding="12,6,12,6"
                                                Margin="0,0,16,0" />
                            <local:MyTextButton x:Name="BtnPlaybackToggle"
                                                Text="播放 / 暂停"
                                                Padding="18,7,18,7"
                                                Margin="0,0,16,0" />
                            <local:MyTextButton x:Name="BtnPlaybackNext"
                                                Text="下一首"
                                                Padding="12,6,12,6" />
                        </StackPanel>

                        <Grid Margin="0,0,0,16" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音量"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource ColorBrush2}"
                                       Margin="0,0,12,0" />
                            <local:MySlider x:Name="SliderVolume"
                                            Grid.Column="1"
                                            MaxValue="100"
                                            Value="100"
                                            VerticalAlignment="Center" />
                            <TextBlock x:Name="LabPlaybackVolume"
                                       Grid.Column="2"
                                       Text="100%"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource ColorBrushGray3}"
                                       Margin="12,0,0,0" />
                        </Grid>

                        <StackPanel x:Name="PanHomeLyrics">
                            <Border MinHeight="230"
                                    CornerRadius="6"
                                    Background="{DynamicResource ColorBrushBackground}"
                                    Padding="24"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="LabHomeLyricPrevious"
                                               Grid.Row="1"
                                               Text=""
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontSize="15"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               Opacity="0.72"
                                               Margin="0,0,0,12" />
                                    <TextBlock x:Name="LabHomeLyricCurrent"
                                               Grid.Row="2"
                                               Text="歌词等待中..."
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ColorBrush3}"
                                               Margin="0,0,0,12" />
                                    <TextBlock x:Name="LabHomeLyricNext"
                                               Grid.Row="3"
                                               Text=""
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontSize="15"
                                               Foreground="{DynamicResource ColorBrushGray3}"
                                               Opacity="0.72"
                                               VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PanHomePlaylist" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PanQueueTab"
                                        CornerRadius="6"
                                        Background="{DynamicResource ColorBrush7}"
                                        Margin="0,0,6,0">
                                    <local:MyTextButton x:Name="BtnQueueTab"
                                                        Text="队列"
                                                        Padding="10,4,10,4" />
                                </Border>
                                <Border x:Name="PanHistoryTab"
                                        CornerRadius="6"
                                        Background="{DynamicResource ColorBrushSemiTransparent}">
                                    <local:MyTextButton x:Name="BtnHistoryTab"
                                                        Text="历史"
                                                        Padding="10,4,10,4" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <local:MyIconButton x:Name="BtnQueueClear"
                                                    Width="24"
                                                    Height="24"
                                                    LogoScale="0.82"
                                                    ToolTip="清空"
                                                    Margin="0,0,6,0" />
                                <local:MyIconButton x:Name="BtnPlaybackRefresh"
                                                    Width="24"
                                                    Height="24"
                                                    LogoScale="0.84"
                                                    ToolTip="刷新" />
                            </StackPanel>
                            </Grid>
                            <TextBlock x:Name="LabQueueSummary"
                                       Text=""
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Foreground="{DynamicResource ColorBrush2}"
                                       Margin="0,0,0,10"
                                       Visibility="Collapsed" />
                            <StackPanel x:Name="PanQueueList" />
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>
            </Grid>

            <local:MyCard x:Name="CardLibrary" Title="音乐库" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="20,38,20,18">
                    <TextBlock x:Name="LabLibrarySummary"
                               Text="等待连接后端..."
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrush2}"
                               Margin="0,0,0,10" />
                    <local:MySearchBox x:Name="SearchLibrary"
                                       HintText="搜索歌曲、歌手、专辑、歌单或来源"
                                       Margin="0,0,0,12" />
                    <TextBlock x:Name="LabPlaylistSourcesSummary"
                               Text=""
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               Margin="0,0,0,8"
                               Visibility="Collapsed" />
                    <StackPanel x:Name="PanPlaylistSources" Margin="0,0,0,12" Visibility="Collapsed" />
                    <StackPanel x:Name="PanLibraryList" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardModules" Title="音源管理" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="20,38,20,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
                        <local:MyTextButton x:Name="BtnModulesTab"
                                            Text="音源管理"
                                            Padding="8,4,8,4"
                                            Margin="0,0,8,0" />
                        <local:MyTextButton x:Name="BtnGameIntegrationTab"
                                            Text="游戏集成"
                                            Padding="8,4,8,4" />
                    </StackPanel>
                    <TextBlock x:Name="LabModulesSummary"
                               Text="等待连接后端..."
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrush2}"
                               Margin="0,0,0,10" />
                    <StackPanel x:Name="PanModulesList" />
                    <WrapPanel x:Name="PanLaunchpadList" Visibility="Collapsed" />
                    <StackPanel x:Name="PanGameIntegrationList" Visibility="Collapsed" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardModuleUi" Title="" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="20,20,20,18">
                    <Border Height="46"
                            CornerRadius="6"
                            Background="{DynamicResource ColorBrushSemiTransparent}"
                            Margin="0,0,0,14">
                        <Grid>
                            <local:MyIconButton x:Name="BtnModuleUiBack"
                                                HorizontalAlignment="Left"
                                                Theme="Black"
                                                Opacity="0.65"
                                                Width="28"
                                                Height="28"
                                                Margin="10,0,0,0"
                                                LogoScale="0.84"
                                                ToolTip="返回"
                                                Logo="M1097 584 250 584 562 896C591 925 591 972 562 1001 533 1030 487 1030 458 1001L21 565C6 550-0 531 0 511L0 511 0 511C-0 492 6 472 21 457L458 21C487-7 533-7 562 21 591 50 591 97 562 126L250 438 1097 438C1137 438 1170 471 1170 511 1170 551 1137 584 1097 584L1097 584Z" />
                            <TextBlock x:Name="LabModuleUiTitle"
                                       Margin="50,0,14,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorBrush3}" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="LabModuleUiSummary"
                               Text="等待加载模块 UI..."
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrush2}"
                               Margin="0,0,0,10" />
                    <StackPanel x:Name="PanModuleUi" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardSettings" Title="设置" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="20,38,20,18">
                    <TextBlock x:Name="LabSettingsSummary"
                               Text="等待连接后端..."
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource ColorBrush2}"
                               Margin="0,0,0,14" />

                    <Grid x:Name="PanSettingsConfig" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="监听端口"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush2}" />
                        <local:MyTextBox x:Name="TxtBackendPort"
                                         Grid.Column="1"
                                         Height="34"
                                         HintText="17890" />
                        <TextBlock Grid.Row="2"
                                   Text="绑定地址"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush2}" />
                        <local:MyTextBox x:Name="TxtBackendBind"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Height="34"
                                         HintText="127.0.0.1" />
                        <TextBlock Grid.Row="4"
                                   Text="后端程序"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush2}" />
                        <Grid Grid.Row="4"
                              Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyTextBox x:Name="TxtBackendPath"
                                             Height="34"
                                             HintText="OmniMixPlayer.Backend.exe" />
                            <local:MyIconButton x:Name="BtnBackendPathBrowse"
                                                Grid.Column="1"
                                                Width="28"
                                                Height="28"
                                                Margin="8,3,0,3"
                                                LogoScale="1.0"
                                                ToolTip="选择后端程序" />
                            <local:MyIconButton x:Name="BtnBackendPathReset"
                                                Grid.Column="2"
                                                Width="28"
                                                Height="28"
                                                Margin="6,3,0,3"
                                                LogoScale="0.84"
                                                ToolTip="恢复默认后端" />
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="PanSettingsChecks" Orientation="Horizontal" Margin="0,0,0,14">
                        <local:MyCheckBox x:Name="CheckAutostart"
                                          Text="开机自启动"
                                          Margin="0,0,22,0" />
                        <local:MyCheckBox x:Name="CheckMinimizeToTray"
                                          Text="最小化到托盘"
                                          Margin="0,0,22,0" />
                        <local:MyCheckBox x:Name="CheckCloseBackendWithGui"
                                          Text="关闭 GUI 时停止后端"
                                          Margin="0,0,22,0"
                                          ToolTip="开启后，退出 OmniMix 界面会同时停止当前连接的后端；关闭后后端会继续运行。" />
                        <local:MyCheckBox x:Name="CheckDesktopPlayerEnabled"
                                          Text="启用桌面播放器实例"
                                          ToolTip="开启后，GUI 会注册一个本机播放实例，并播放后端解码后的共享 PCM 音频。" />
                    </StackPanel>

                    <StackPanel x:Name="PanSettingsConfigButtons" Orientation="Horizontal" Margin="0,0,0,16">
                        <local:MyTextButton x:Name="BtnSettingsRefresh"
                                            Text="刷新配置"
                                            Padding="9,5,9,5"
                                            Margin="0,0,12,0" />
                        <local:MyTextButton x:Name="BtnSettingsSave"
                                            Text="保存配置"
                                            Padding="9,5,9,5"
                                            Margin="0,0,12,0" />
                        <local:MyTextButton x:Name="BtnBackendReconnect"
                                            Text="启动/重连"
                                            Padding="9,5,9,5"
                                            Margin="0,0,12,0" />
                        <local:MyTextButton x:Name="BtnBackendStop"
                                            Text="停止后端"
                                            Padding="9,5,9,5" />
                    </StackPanel>

                    <StackPanel x:Name="PanSettingsPersonalization"
                                Margin="0,0,0,18"
                                Visibility="Collapsed"
                                Grid.IsSharedSizeScope="True">
                        <local:MyCard Title="窗口与背景" Margin="0,0,0,15">
                            <Grid Margin="25,40,25,17">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingName" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="LabWindowOpacity"
                                           Text="窗口不透明度：100%"
                                           VerticalAlignment="Center"
                                           Margin="0,0,22,0" />
                                <local:MySlider x:Name="SliderWindowOpacity"
                                                Grid.Column="1"
                                                local:SettingService.Key="UiLauncherTransparent"
                                                MaxValue="100" />
                                <TextBlock x:Name="LabControlOpacity"
                                           Grid.Row="2"
                                           Text="控件不透明度：80%"
                                           VerticalAlignment="Center"
                                           Margin="0,0,22,0" />
                                <local:MySlider x:Name="SliderControlOpacity"
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                local:SettingService.Key="UiControlOpacity"
                                                MaxValue="100" />
                                <TextBlock x:Name="LabBackgroundOpacity"
                                           Grid.Row="4"
                                           Text="背景图不透明度：100%"
                                           VerticalAlignment="Center"
                                           Margin="0,0,22,0" />
                                <local:MySlider x:Name="SliderBackgroundOpacity"
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                local:SettingService.Key="UiBackgroundOpacity"
                                                MaxValue="100" />
                                <TextBlock x:Name="LabBackgroundClarity"
                                           Grid.Row="6"
                                           Text="背景清晰度：100%"
                                           VerticalAlignment="Center"
                                           Margin="0,0,22,0" />
                                <local:MySlider x:Name="SliderBackgroundClarity"
                                                Grid.Row="6"
                                                Grid.Column="1"
                                                local:SettingService.Key="UiBackgroundClarity"
                                                MaxValue="100" />
                                <Border Grid.Row="8"
                                        Grid.ColumnSpan="2"
                                        Background="{DynamicResource ColorBrushSemiTransparent}"
                                        CornerRadius="6"
                                        Padding="14"
                                        Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="背景来源"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ColorBrush3}" />
                                            <TextBlock x:Name="LabBackgroundImagePath"
                                                       Text="使用默认背景图"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ColorBrushGray3}"
                                                       Margin="0,4,12,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <local:MyButton x:Name="BtnSelectBackgroundImage"
                                                            Text="选择图片"
                                                            Margin="0,0,8,0"
                                                            Padding="14,6"
                                                            ColorType="Highlight" />
                                            <local:MyButton x:Name="BtnSolidBackground"
                                                            Text="纯色背景"
                                                            Margin="0,0,8,0"
                                                            Padding="14,6" />
                                            <local:MyButton x:Name="BtnResetBackgroundImage"
                                                            Text="恢复默认"
                                                            Padding="14,6" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </local:MyCard>

                        <local:MyCard Title="主题配色" Margin="0,0,0,15">
                            <StackPanel Margin="25,40,25,17">
                                <WrapPanel Margin="-1,0,0,4">
                                    <local:MyRadioBox x:Name="RadioTheme0"
                                                      Margin="0,0,16,12"
                                                      local:SettingService.Key="UiLauncherTheme"
