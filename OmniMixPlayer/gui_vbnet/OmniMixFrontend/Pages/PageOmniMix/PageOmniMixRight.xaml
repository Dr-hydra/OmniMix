            <local:MyCard x:Name="CardAbout" Title="关于" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="20,38,20,18">
                    <StackPanel x:Name="CardAboutOverview">
                        <TextBlock Text="OmniMix 是由 Dr.Hydra 维护的 Windows 音乐聚合、桌面播放控制和游戏集成播放器。"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="当前版本以 VB.NET/WPF 桌面前端连接本机 .NET 后端，优先通过 OmniMix SDK 与 gRPC-Web 访问播放、曲库和实例能力；REST 仅保留给后端配置、模块 UI、模块设置、模块启停和停止后端等兼容功能。桌面 GUI、系统媒体控制、FH6 桥接和游戏 Mod 都作为同一后端模型的客户端工作。"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="English: OmniMix is a Windows music aggregation player with desktop playback controls, lyrics, source modules, and game integration. The WPF frontend talks to the local OmniMix backend through the SDK first, while keeping REST only for compatibility surfaces that are not yet covered by the SDK."
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Margin="0,0,0,10" />
                        <WrapPanel Margin="0,0,0,14">
                            <local:MyTextButton x:Name="BtnAboutRepository"
                                                Text="打开项目仓库"
                                                Padding="9,5,9,5"
                                                Margin="0,0,10,8" />
                        </WrapPanel>
                        <local:MyListItem Title="当前组件"
                                          Info="桌面前端 4.2.1；FH6 Omni Bridge 3.0.2；网易云、QQ音乐、酷我模块 2.0.0，酷狗模块 2.0.1。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="播放与队列"
                                          Info="主页左侧集中显示封面、进度和基础控制，右侧默认显示播放列表，并可在播放列表、历史和歌词之间切换。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="曲库与音源模块"
                                          Info="聚合本地文件夹、网易云、QQ音乐、酷狗、酷我、哔哩哔哩、Spotify 等来源；支持模块页面、登录状态、个人歌单导入、歌词和翻译歌词能力（取决于平台返回内容）。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="歌词与悬浮窗"
                                          Info="播放页和悬浮窗支持歌词、双语歌词和纯歌词模式；悬浮窗可独立设置显示状态、横版/竖版/纯歌词样式、主题配色、背景配色、窗口透明度、背景透明度和缩放。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="桌面控制"
                                          Info="通过 SMTC 注册系统媒体控制，支持键盘、耳机和系统媒体面板触发播放、暂停、上一首和下一首。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="游戏集成"
                                          Info="FH6 集成通过根桥接方式接入 OmniMix 后端，支持游戏内音频流、歌曲信息写入、媒体资源生成、集成版本检测、实例绑定修复和比赛开始播放行为设置。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="运行方式"
                                          Info="前端会按设置启动或连接后端；完整包会随带后端、模块、原生库、Web 资源、媒体生成器、配置文件和 VB.NET 桌面前端。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="CardAboutUsage" Visibility="Collapsed">
                        <TextBlock Text="常规使用"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Margin="0,0,0,8" />
                        <local:MyListItem Title="首次启动"
                                          Info="推荐使用安装器或完整便携包。便携包解压到可写目录后运行 OmniMixPlayer.Gui.Vbnet.exe；前端会优先查找同目录的 OmniMixPlayer.Backend.exe，也可以在设置中手动指定后端路径。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="播放音乐"
                                          Info="在播放页选择桌面或游戏实例并控制播放；在音源页面浏览歌曲、歌单和模块内容，将歌曲加入队列或直接播放。主页右侧默认显示队列，也可以切换到历史或歌词。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="音源与登录"
                                          Info="部分在线音源需要在音源管理页面完成登录或授权。网易云、QQ音乐、酷我已按 2.0.0 模块更新，酷狗已按 2.0.1 模块更新；若连续多首歌曲无法播放，优先检查账号状态、会员权限和平台版权限制。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="歌词与悬浮窗"
                                          Info="在设置 - 悬浮窗设置中启用播放悬浮窗，并选择横向、竖向或纯歌词模式。纯歌词模式只显示歌词、进度和播放控制，适合桌面常驻。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="媒体快捷键"
                                          Info="系统媒体控制通过 SMTC 初始化。若耳机或键盘媒体键失效，请先确认 OmniMix 后端正在运行，并检查系统媒体面板中是否出现 OmniMix。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <TextBlock Text="游戏集成"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Margin="0,14,0,8" />
                        <local:MyListItem Title="安装集成"
                                          Info="进入音源管理 - 游戏集成，选择游戏目录并安装对应桥接组件。启动游戏前建议先启动 OmniMix，让前端刷新端口文件、实例 ID 和随包桥接版本。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="FH6 设置"
                                          Info="FH6 需要将游戏内 DJ 调整为关、主播模式调整为开并重启游戏。Steam 与 Xbox 版目录结构不同，前端会自动识别实际运行目录、根桥接位置和 media 目录。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="电台 UI 替换"
                                          Info="在 FH6 集成页面可选择 PNG 图片并输入电台名称，前端会调用媒体生成器备份原始文件并写入生成后的 media 文件。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="播放行为"
                                          Info="FH6 进出比赛时默认继续播放；可在设置中改为下一首。若更新后显示或音频异常，请重新安装 FH6 集成并重启游戏。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="卸载与修复"
                                          Info="卸载前请先在游戏集成页面移除桥接组件；如果游戏内无法连接、歌曲信息不同步或仍显示旧版本，可使用修复实例绑定或重新安装集成。"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="CardAboutFeedback" Visibility="Collapsed">
                        <TextBlock Text="问题反馈"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="反馈时请尽量说明复现步骤、当前版本、使用的音源模块、是否启用了桌面播放器或游戏集成，并附上压缩后的日志。"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Margin="0,0,0,10" />
                        <local:MyListItem Title="QQ群"
                                          Info="851586605"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,2" />
                        <local:MyListItem Title="GitHub Issues"
                                          Info="https://github.com/Dr-hydra/OmniMix/issues"
                                          IsHitTestVisible="False"
                                          Margin="-5,0,0,12" />
                        <WrapPanel Margin="0,0,0,10">
                            <local:MyTextButton x:Name="BtnFeedbackGithub"
                                                Text="打开 GitHub Issues"
                                                Padding="9,5,9,5"
                                                Margin="0,0,10,8" />
                            <local:MyTextButton x:Name="BtnFeedbackCompressLogs"
                                                Text="一键压缩日志"
                                                Padding="9,5,9,5"
                                                Margin="0,0,10,8" />
                        </WrapPanel>
                        <TextBlock x:Name="LabFeedbackLogStatus"
                                   Text="日志压缩包会生成到 AppData\Roaming\OmniMixPlayer\feedback。"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Margin="0,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
